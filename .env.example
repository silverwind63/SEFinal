# 複製成 .env 後填入實際值；.env 已列入 .gitignore，不可提交。

# 必填：老師登入密碼
GB_TEACHER_PASSWORD=change-me
# 必填：Google OAuth client JSON（桌面應用程式類型）的完整路徑（放在 repo 以外）
GB_GOOGLE_OAUTH_CLIENT_FILE=/path/to/oauth-client.json

# 選填（括號內為預設值）
# 資料目錄，存放 SQLite 資料庫（./var）
GB_DATA_DIR=./var
# 監聽位址與連接埠（127.0.0.1、8000）
GB_HOST=127.0.0.1
GB_PORT=8000
# login-google 儲存 token 的位置（<GB_DATA_DIR>/google-token.json）；不可提交到版本庫
# GB_GOOGLE_TOKEN_FILE=./var/google-token.json
# Sheets API 逾時秒數（10）
GB_SHEETS_TIMEOUT_SECONDS=10
# 每份學習單的題數上限（500）
GB_MAX_QUESTIONS=500
# 表頭標籤（題號、題目、作答）
GB_HEADER_LABEL_NUMBER=題號
GB_HEADER_LABEL_QUESTION=題目
GB_HEADER_LABEL_ANSWER=作答
# 老師 Token 有效秒數（28800）
GB_TOKEN_TTL_SECONDS=28800
# 連續登入失敗上限與鎖定秒數（5、300）
GB_LOGIN_MAX_FAILURES=5
GB_LOGIN_LOCK_SECONDS=300
# 只供測試使用：設定後，寫回與匯出改讀這個目錄的 JSON 結果檔，不讀搶答活動保存的結果；正常使用請保持不設定
# GB_RESULTS_DIR=./var/results

# ---- 002 搶答活動（括號內為預設值） ----
# 組數上限（20）、組名長度上限（20）、答案長度上限（200）
GB_MAX_TEAMS=20
GB_TEAM_NAME_MAX=20
GB_MAX_ANSWER_LENGTH=200
# 公平機制：是否啟用（true）、冷卻秒數 N（10，1–600）、領先門檻 K（2，1–100）
GB_FAIRNESS_ENABLED=true
GB_COOLDOWN_SECONDS=10
GB_COOLDOWN_LEAD=2
# 輸入組別代碼：每個視窗連續錯誤上限與鎖定秒數（5、60）、全體每分鐘錯誤上限（60）
GB_JOIN_MAX_FAILURES=5
GB_JOIN_LOCK_SECONDS=60
GB_JOIN_GLOBAL_FAILURES_PER_MIN=60
# WebSocket 連線後必須送出驗證訊息的秒數（5）
GB_WS_AUTH_TIMEOUT_SECONDS=5
