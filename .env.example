# 複製成 .env 後填入實際值；.env 已列入 .gitignore，不可提交。

# 必填：老師登入密碼
GB_TEACHER_PASSWORD=change-me
# 必填：Google service account 金鑰檔的完整路徑（金鑰檔放在 repo 以外）
GB_GOOGLE_CREDENTIALS_FILE=/path/to/service-account.json

# 選填（括號內為預設值）
# 資料目錄，存放 SQLite 資料庫（./var）
GB_DATA_DIR=./var
# 監聽位址與連接埠（127.0.0.1、8000）
GB_HOST=127.0.0.1
GB_PORT=8000
# Sheets API 逾時秒數（10）
GB_SHEETS_TIMEOUT_SECONDS=10
# 每份學習單的題數上限（500）
GB_MAX_QUESTIONS=500
# 表頭標籤（題號、題目、作答）
GB_HEADER_LABEL_NUMBER=題號
GB_HEADER_LABEL_QUESTION=題目
GB_HEADER_LABEL_ANSWER=作答
# 老師 Token 有效秒數（28800）
GB_TOKEN_TTL_SECONDS=28800
# 連續登入失敗上限與鎖定秒數（5、300）
GB_LOGIN_MAX_FAILURES=5
GB_LOGIN_LOCK_SECONDS=300
# 搶答結果 JSON 檔目錄（002 完成前用於驗證寫回與匯出；未設定則停用）
# GB_RESULTS_DIR=./var/results
